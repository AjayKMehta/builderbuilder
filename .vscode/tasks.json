{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BuilderBuilder.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign",
        "-c",
        "${input:config}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Test: MTP Hot Reload",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/tests/BuilderGenerator.Tests/BuilderGenerator.Tests.csproj"
      ],
      "options": {
        "env": {
          "TESTINGPLATFORM_HOTRELOAD_ENABLED": "1"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      // https://marketplace.visualstudio.com/items?itemName=rioj7.command-variable#pickstringremember
      "id": "config",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "key": "buildConfig",
        "addLabelToTop": "${remember:buildConfig}",
        "default": "Debug",
        // Directory names are case-sensitive in Linux.
        "options": [
          [
            "Debug",
            "debug"
          ],
          [
            "Release",
            "release"
          ]
        ],
        "description": "Build configuration"
      }
    }
  ]
}
